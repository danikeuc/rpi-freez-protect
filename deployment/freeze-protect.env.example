# Copy to /etc/rpi-freeze-protect/environment, replace every value, then chmod 0600.
FREEZE_PROTECT_DB_PATH=/var/lib/rpi-freeze-protect/freeze-protect.db
FREEZE_PROTECT_ADMIN_TOKEN=replace-with-a-long-random-admin-token
FREEZE_PROTECT_DISPLAY_TOKEN=replace-with-a-different-long-random-display-token
FREEZE_PROTECT_INTEGRATION_TOKEN=replace-with-a-fourth-independent-random-token
FREEZE_PROTECT_NODE_RED_URL=http://127.0.0.1:1880/internal/freeze-protect/actuator
FREEZE_PROTECT_NODE_RED_TOKEN=replace-with-a-third-long-random-shared-token
FREEZE_PROTECT_DEVELOPMENT_MODE=false

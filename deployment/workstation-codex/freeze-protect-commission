#!/bin/sh
set -eu

PATH=/usr/sbin:/usr/bin
export PATH

if [ "$#" -ne 1 ]; then
  echo "usage: freeze-protect-commission {inventory|status|diagnose-pair-gpio|drain}" >&2
  exit 64
fi

exec /usr/bin/env -i PATH="$PATH" /bin/sh -s -- "$1" <<'CLEAN_ENV'
set -eu
set -f

case "${1:-}" in
  inventory)
    uname -a
    id freezeprotect
    git -C /opt/rpi-freez-protect rev-parse HEAD
    ;;
  status)
    systemctl is-active node-red.service
    systemctl is-active freeze-protect-pair-gpio.service
    systemctl is-active freeze-protect.service
    pinctrl get 26
    pinctrl get 20
    ;;
  diagnose-pair-gpio)
    unit=freeze-protect-pair-gpio.service
    diagnostic_status=0

    echo "section=systemd-show"
    for property in \
      ActiveState SubState Result Type MainPID ExecMainStatus ExecMainCode \
      NRestarts ActiveEnterTimestamp InactiveExitTimestamp
    do
      property_value=$(
        /usr/bin/systemctl show "$unit" --no-pager \
          --property="$property" --value 2>/dev/null
      ) || {
        printf '%s=unavailable\n' "$property"
        diagnostic_status=1
        continue
      }
      case "$property_value" in
        ''|*[!A-Za-z0-9_.:,+/\ -]*)
          printf '%s=invalid\n' "$property"
          diagnostic_status=1
          ;;
        *)
          if [ "${#property_value}" -gt 127 ]; then
            printf '%s=invalid\n' "$property"
            diagnostic_status=1
          else
            printf '%s=%s\n' "$property" "$property_value"
          fi
          ;;
      esac
    done

    echo "section=main-process"
    main_pid=$(/usr/bin/systemctl show "$unit" --property=MainPID --value 2>/dev/null || true)
    case "$main_pid" in
      ''|*[!0-9]*)
        echo "main-process=invalid-pid"
        diagnostic_status=1
        ;;
      0)
        echo "main-process=none"
        ;;
      *)
        process_state=$(/usr/bin/ps -p "$main_pid" -o stat= 2>/dev/null || true)
        case "$process_state" in
          ''|*[!A-Za-z0-9+\<]*)
            echo "main-process=not-running-or-invalid-state"
            diagnostic_status=1
            ;;
          *)
            printf 'main-process-pid=%s\n' "$main_pid"
            printf 'main-process-state=%s\n' "$process_state"
            ;;
        esac
        ;;
    esac

    echo "section=installed-artifacts"
    for artifact in \
      /etc/systemd/system/freeze-protect-pair-gpio.service \
      /opt/rpi-freez-protect/deployment/node-red/paired_gpio_daemon.py \
      /usr/local/sbin/freeze-protect-commission
    do
      printf 'artifact=%s\n' "$artifact"
      artifact_evidence=$(/usr/bin/python3 -I - "$artifact" <<'PY'
import hashlib
import os
import stat
import sys

path = sys.argv[1]
try:
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb", closefd=True) as stream:
        before = os.fstat(stream.fileno())
        if not stat.S_ISREG(before.st_mode):
            raise OSError
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
        after = os.fstat(stream.fileno())
    identity_before = (
        before.st_dev,
        before.st_ino,
        before.st_size,
        before.st_mtime_ns,
        before.st_ctime_ns,
        before.st_mode,
        before.st_uid,
        before.st_gid,
    )
    identity_after = (
        after.st_dev,
        after.st_ino,
        after.st_size,
        after.st_mtime_ns,
        after.st_ctime_ns,
        after.st_mode,
        after.st_uid,
        after.st_gid,
    )
    if identity_before != identity_after:
        raise OSError
except (OSError, ValueError):
    sys.exit(1)

print(
    "metadata="
    f"{before.st_uid}:{before.st_gid}:{stat.S_IMODE(before.st_mode):o}:"
    f"{before.st_size}:{before.st_mtime_ns}:{before.st_dev}:{before.st_ino}"
)
print(f"sha256={digest}")
PY
      ) || {
        echo "artifact-state=missing-not-regular-or-changed"
        diagnostic_status=1
        continue
      }
      printf '%s\n' "$artifact_evidence"
    done

    echo "journal-output=omitted: unrestricted service messages cannot be proven secret-free"
    exit "$diagnostic_status"
    ;;
  drain)
    receipt=$(/usr/bin/python3 -I /usr/local/lib/freeze-protect-commission/paired_gpio_client.py DRAIN)
    # The Node-RED client deliberately exits zero for structured failures.
    # Require one complete, successful DRAIN receipt, not process success alone.
    if ! printf '%s\n' "$receipt" | /usr/bin/python3 -I -c '
import json
import sys
try:
    receipt = json.load(sys.stdin)
    valid = (
        isinstance(receipt, dict)
        and receipt.get("ok") is True
        and receipt.get("command") == "DRAIN"
        and receipt.get("gpio") == {"26": 1, "20": 1}
    )
except (ValueError, TypeError):
    valid = False
sys.exit(0 if valid else 1)
'; then
      echo "daemon did not confirm a successful DRAIN receipt; stop commissioning" >&2
      exit 1
    fi
    printf '%s\n' "$receipt"

    gpio_26=$(pinctrl get 26)
    gpio_20=$(pinctrl get 20)
    printf '%s\n' "$gpio_26"
    printf '%s\n' "$gpio_20"

    if ! printf '%s\n' "$gpio_26" | grep -Eq '(^|[[:space:]])op([[:space:]]|$)' ||
       ! printf '%s\n' "$gpio_26" | grep -Eq '(^|[[:space:]])hi([[:space:]]|$)'; then
      echo "GPIO 26 is not output/high after DRAIN; stop commissioning" >&2
      exit 1
    fi
    if ! printf '%s\n' "$gpio_20" | grep -Eq '(^|[[:space:]])op([[:space:]]|$)' ||
       ! printf '%s\n' "$gpio_20" | grep -Eq '(^|[[:space:]])hi([[:space:]]|$)'; then
      echo "GPIO 20 is not output/high after DRAIN; stop commissioning" >&2
      exit 1
    fi
    ;;
  *)
    echo "usage: freeze-protect-commission {inventory|status|diagnose-pair-gpio|drain}" >&2
    exit 64
    ;;
esac
CLEAN_ENV

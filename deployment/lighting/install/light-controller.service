[Unit]
Description=Independent light policy controller
ConditionPathExists=/etc/independent-light/commissioned
Requires=light-gpio.service
After=light-gpio.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=independent-light
Group=independent-light
WorkingDirectory=/opt/independent-light
EnvironmentFile=/etc/independent-light/controller.env
ExecStart=/opt/independent-light/venv/bin/python -I -B -m freeze_protect.lighting.main
Restart=on-failure
RestartSec=2
TimeoutStartSec=15
TimeoutStopSec=5
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
PrivateDevices=true
StateDirectory=independent-light
StateDirectoryMode=0700
ReadWritePaths=/var/lib/independent-light /run/independent-light

[Install]
WantedBy=multi-user.target

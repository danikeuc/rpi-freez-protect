# Templates only. Keep real separate secrets in mode-0600 external files.
LIGHT_DB_PATH=/var/lib/independent-light/independent-light.db
LIGHT_DISPLAY_TOKEN=
LIGHT_SETTINGS_TOKEN=
LIGHT_CAMERA_TOKEN=
LIGHT_ALLOWED_SOURCES=
LIGHT_EXECUTOR_SOCKET=/run/independent-light/executor.sock
# GPIO_SHARED_FSEL2_COEXISTENCE is an open activation blocker.
# Do not opt in LIGHT_GPIO21_ENABLED or create the service marker
# with the installed legacy paired mmap daemon. Candidate source repair needs
# exact installed migration plus regression/physical acceptance evidence.
# Initial ordering/userspace locking alone do not cover kernel cleanup.
# Only commissioning AFTER that blocker is closed enables ingress or hardware.
LIGHT_UNIFI_ENABLED=
LIGHT_UNIFI_INGRESS_TOKEN=
LIGHT_UNIFI_PROFILE=
LIGHT_GPIO21_ENABLED=
LIGHT_GPIO_CHIP=
LIGHT_GPIO21_ACTIVE_LOW=
